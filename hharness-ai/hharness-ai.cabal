cabal-version: 3.0
name:          hharness-ai
version:       0.1.0.0
synopsis:      Unified multi-provider LLM streaming API
description:
  Haskell equivalent of @mariozechner/pi-ai@.
  Provides core types, an STM-backed event stream, an API registry,
  and provider implementations for Anthropic and OpenAI.

license:       MIT
build-type:    Simple

common shared
  ghc-options:        -Wall
  default-language:   GHC2021
  default-extensions:
    DeriveGeneric
    LambdaCase
    OverloadedStrings
    RecordWildCards

  build-depends:
    , aeson            ^>=2.1  || ^>=2.2
    , async            ^>=2.2
    , base             ^>=4.17 || ^>=4.18 || ^>=4.19 || ^>=4.20
    , bytestring       ^>=0.11 || ^>=0.12
    , claude           ^>=1.4
    , containers       ^>=0.6  || ^>=0.7
    , http-client      ^>=0.7
    , http-client-tls  ^>=0.3
    , http-types       ^>=0.12
    , scientific       ^>=0.3
    , stm              ^>=2.5
    , text             ^>=1.2  || ^>=2.0  || ^>=2.1
    , time             ^>=1.12
    , vector           ^>=0.13 || ^>=0.14

library
  import:          shared
  exposed-modules:
    HHAi
    HHAi.Auth
    HHAi.Models
    HHAi.Provider.Anthropic
    HHAi.Provider.Faux
    HHAi.Registry
    HHAi.Stream
    HHAi.Types

  hs-source-dirs:  src
