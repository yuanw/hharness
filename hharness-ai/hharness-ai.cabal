name:          hharness-ai
version:       0.1.0.0
synopsis:      Unified multi-provider LLM streaming API
description:
  Haskell equivalent of @mariozechner/pi-ai@.
  Provides core types, an STM-backed event stream, an API registry,
  and provider implementations for Anthropic and OpenAI.

license:       MIT
build-type:    Simple

library
  exposed-modules:
    HHAi
    HHAi.Auth
    HHAi.Models
    HHAi.Provider.Anthropic
    HHAi.Provider.Faux
    HHAi.Provider.OpenAI
    HHAi.Registry
    HHAi.Stream
    HHAi.Types

  other-modules:      Paths_hharness_ai
  hs-source-dirs:     src
  default-extensions:
    DeriveGeneric
    LambdaCase
    OverloadedStrings
    RecordWildCards

  ghc-options:        -Wall
  build-depends:
      aeson            >=2.1  && <2.3
    , async            >=2.2  && <2.3
    , base             >=4.17 && <4.21
    , bytestring       >=0.11 && <0.13
    , claude           >=1.4  && <1.5
    , containers       >=0.6  && <0.8
    , http-client      >=0.7  && <0.8
    , http-client-tls  >=0.3  && <0.4
    , http-types       >=0.12 && <0.13
    , scientific       >=0.3  && <0.4
    , stm              >=2.5  && <2.6
    , text             >=1.2  && <1.3  || >=2.0 && <2.2
    , time             >=1.12 && <1.13
    , vector           >=0.13 && <0.15

  default-language:   GHC2021
